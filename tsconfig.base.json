{
  "compilerOptions": {
    "target": "es2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "incremental": true,
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declarationMap": true
  }
}
